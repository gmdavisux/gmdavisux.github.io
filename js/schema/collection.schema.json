{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortfolioCollection",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "url"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "description": "Home: ./ or empty. Pages: ?page=<slug>"
      },
      "src": {
        "type": "string"
      },
      "alt": {
        "type": "string"
      },
      "description": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}